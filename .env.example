# SUAS environment template — safe placeholders only
# Canonical contract: SUAS-specs/ENVIRONMENT.md v0.1.1

SUAS_ENV=LOCAL
SUAS_SPEC_VERSION=0.1.1
SUAS_RELEASE_MANIFEST=RELEASE_MANIFEST-0.1.1.md
SUAS_ALLOW_REAL_EXTERNAL_EFFECTS=false

# Persistence — local/test implementation value only; never commit credentials.
DATABASE_URL=postgresql://suas:suas@localhost:5432/suas_local
DATABASE_POOL_MAX=5
SUAS_MIGRATIONS_MODE=validate

# Session/auth implementation secret. Set locally outside git when required.
SUAS_SESSION_SECRET=

# Communications remain fake/sink/disabled until a later released provider decision.
SUAS_EMAIL_MODE=sink
SUAS_SMS_MODE=sink

# MVP service adapters: manual/fake/disabled only in current release.
SUAS_TRANSPORTATION_ADAPTER_MODE=fake
SUAS_SHELTER_ADAPTER_MODE=fake
SUAS_FOOD_ADAPTER_MODE=fake
SUAS_PEER_SUPPORT_ADAPTER_MODE=manual

# Production scoring/copy/reporting remain unavailable.
SUAS_SUPPORT_SIGNAL_MODE=fixture
SUAS_SAFETY_COPY_MODE=placeholder_test_only
SUAS_SENSITIVE_AGGREGATE_REPORTING=disabled
